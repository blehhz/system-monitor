{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Sysfetch",
            "type": "shell",
            "command": "cmake --build backend/build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Sysfetch",
            "type": "shell",
            "command": "./backend/build/sysfetch"
        },
        {
            "label": "Build and Run Sysfetch",
            "type": "shell",
            "command": "cmake --build backend/build && ./backend/build/sysfetch"
        }
    ]
}