{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Sysfetch",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Sysfetch",
            "type": "shell",
            "command": "./build/sysfetch"
        },
        {
            "label": "Build and Run Sysfetch",
            "type": "shell",
            "command": "cmake --build build && ./build/sysfetch"
        }
    ]
}